# Salin ke .env untuk jalan lokal (npm run dev memakai: node --env-file=.env).
# Di Railway, isi semua variabel ini lewat tab Variables. JANGAN commit file .env asli.

# Port dibaca dari Railway otomatis. Untuk lokal boleh dikosongkan (default 3000).
PORT=3000

# Password login Admin Web (minimal 12 karakter).
ADMIN_PASSWORD=ganti-dengan-password-panjang-dan-acak

# Kunci penanda sesi admin (minimal 32 karakter acak).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Token GitHub fine-grained: akses HANYA ke repo data, permission Contents = Read and write.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=nama-akun-github
GITHUB_REPO=fc27-squad-data
GITHUB_BRANCH=main
GITHUB_CONFIG_PATH=squad-config.json

# Opsional. Host yang boleh dipakai sebagai link unduhan (pisahkan koma, "*." = semua subdomain).
# ALLOWED_DOWNLOAD_HOSTS=github.com,*.githubusercontent.com

# Opsional. Lama data config disimpan di memori sebelum dibaca ulang dari GitHub (detik).
# CACHE_TTL_SECONDS=15
